{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MathBlocks",
  "version": "0.1.0",
  "identifier": "app.mathblocks.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MathBlocks",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false
      },
      {
        "label": "panel",
        "title": "MathBlocks",
        "url": "index.html?panel=1",
        "width": 900,
        "height": 580,
        "minWidth": 560,
        "minHeight": 360,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "resizable": true,
        "dragDropEnabled": false,
        "focus": true,
        "shadow": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost https://api.anthropic.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": false
  },
  "mainBinaryName": "MathBlocks",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIyNUM5QzI0NTA2NjFENDMKUldSREhXWlFKSnhjc3RHN0FEU29hU3BKMFhydFVPRDljTy8vdm1YdGlTbXlyVVdUL21HYmcvSEEK",
      "endpoints": [
        "https://github.com/mhalafandy/math-blocks/releases/download/dev-build/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
