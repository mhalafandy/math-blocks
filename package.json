{
  "name": "mathblocks",
  "private": true,
  "version": "0.1.0",
  "description": "MathBlocks — advanced mathematical equation editor for Microsoft Word",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter @mathblocks/app typecheck",
    "spike:docx": "tsx tools/make-spike-docx.ts",
    "dev": "pnpm --filter @mathblocks/app dev",
    "app:dev": "pnpm --filter @mathblocks/app tauri dev",
    "app:build": "pnpm --filter @mathblocks/app tauri build",
    "spike:precision": "tsx tools/make-precision-spike.ts"
  },
  "devDependencies": {
    "@mathblocks/math-core": "workspace:*",
    "@mathblocks/math-latex": "workspace:*",
    "@mathblocks/math-omml": "workspace:*",
    "@mathblocks/ooxml": "workspace:*",
    "@mathjax/mathjax-newcm-font": "4.1.3",
    "@mathjax/src": "4.1.3",
    "@types/node": "^22.10.0",
    "fast-xml-parser": "^5.2.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12",
    "@mathblocks/mathtype": "workspace:*"
  }
}
